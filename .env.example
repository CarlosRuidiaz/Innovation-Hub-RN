# Copia este archivo como .env (en Windows: copy .env.example .env).
# El .env no va al repositorio.
#
# Expo lee las variables EXPO_PUBLIC_* al arrancar `npm start`. Si las cambias,
# reinicia con `npx expo start --clear`.
#
# Todo el grupo usa el mismo proyecto de Roble que la app Flutter: son los
# valores de lib/core/roble_config.dart.

# El host del API de Roble. Es roble-api..., no roble... (ese sirve la consola).
EXPO_PUBLIC_ROBLE_BASE_URL=https://roble-api.test-openlab.uninorte.edu.co

# El proyecto de Roble.
EXPO_PUBLIC_ROBLE_CONTRACT_ID=innovation_hub_f5910840c3
